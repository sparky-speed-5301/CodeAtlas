{
  "additionalProperties": false,
  "description": "Bounded reviewer outcome without comments, prompts, transcripts, or source.",
  "properties": {
    "protocol_version": {"maxLength": 64, "minLength": 1, "title": "Protocol Version", "type": "string"},
    "benchmark_version": {"maxLength": 64, "minLength": 1, "title": "Benchmark Version", "type": "string"},
    "case_id": {"pattern": "^[a-z0-9][a-z0-9._-]{0,127}$", "title": "Case Id", "type": "string"},
    "run_id": {"pattern": "^[A-Za-z0-9._:-]{1,128}$", "title": "Run Id", "type": "string"},
    "reviewer_id_hash": {"pattern": "^[0-9a-f]{64}$", "title": "Reviewer Id Hash", "type": "string"},
    "context_identity_hash": {"pattern": "^[0-9a-f]{64}$", "title": "Context Identity Hash", "type": "string"},
    "started_at": {"format": "date-time", "title": "Started At", "type": "string"},
    "completed_at": {"format": "date-time", "title": "Completed At", "type": "string"},
    "understand_finding": {"enum": ["yes", "no", "not_evaluated"], "title": "Understand Finding", "type": "string"},
    "identify_affected_code": {"enum": ["yes", "no", "not_evaluated"], "title": "Identify Affected Code", "type": "string"},
    "understand_evidence": {"enum": ["yes", "no", "not_evaluated"], "title": "Understand Evidence", "type": "string"},
    "decide_finding_validity": {"enum": ["yes", "no", "not_evaluated"], "title": "Decide Finding Validity", "type": "string"},
    "understand_proposed_fix": {"enum": ["yes", "no", "not_evaluated"], "title": "Understand Proposed Fix", "type": "string"},
    "choose_fix_action": {"enum": ["yes", "no", "not_evaluated"], "title": "Choose Fix Action", "type": "string"},
    "validate_result": {"enum": ["yes", "no", "not_evaluated"], "title": "Validate Result", "type": "string"},
    "recover_safely": {"enum": ["yes", "no", "not_evaluated"], "title": "Recover Safely", "type": "string"},
    "finding_outcome": {"enum": ["accepted", "rejected", "needs_more_context", "needs_regeneration", "abstained", "not_evaluated"], "title": "Finding Outcome", "type": "string"},
    "fix_outcome": {"enum": ["accepted", "rejected", "needs_more_context", "needs_regeneration", "abstained", "not_evaluated"], "title": "Fix Outcome", "type": "string"},
    "time_to_understand_finding_ms": {"anyOf": [{"maximum": 86400000, "minimum": 0, "type": "integer"}, {"type": "null"}], "default": null, "title": "Time To Understand Finding Ms"},
    "time_to_resolve_finding_ms": {"anyOf": [{"maximum": 604800000, "minimum": 0, "type": "integer"}, {"type": "null"}], "default": null, "title": "Time To Resolve Finding Ms"},
    "time_to_first_useful_finding_ms": {"anyOf": [{"maximum": 86400000, "minimum": 0, "type": "integer"}, {"type": "null"}], "default": null, "title": "Time To First Useful Finding Ms"},
    "time_to_accepted_fix_ms": {"anyOf": [{"maximum": 604800000, "minimum": 0, "type": "integer"}, {"type": "null"}], "default": null, "title": "Time To Accepted Fix Ms"},
    "manual_correction_baseline_ms": {"anyOf": [{"maximum": 604800000, "minimum": 0, "type": "integer"}, {"type": "null"}], "default": null, "title": "Manual Correction Baseline Ms"},
    "reason_codes": {"default": [], "items": {"type": "string"}, "maxItems": 20, "title": "Reason Codes", "type": "array"}
  },
  "required": [
    "protocol_version",
    "benchmark_version",
    "case_id",
    "run_id",
    "reviewer_id_hash",
    "context_identity_hash",
    "started_at",
    "completed_at",
    "understand_finding",
    "identify_affected_code",
    "understand_evidence",
    "decide_finding_validity",
    "understand_proposed_fix",
    "choose_fix_action",
    "validate_result",
    "recover_safely",
    "finding_outcome",
    "fix_outcome"
  ],
  "title": "HumanReviewEvaluation",
  "type": "object"
}
