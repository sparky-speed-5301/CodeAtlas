{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codeatlas.dev/schemas/finding.schema.json",
  "title": "CodeAtlas Finding",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "file", "start_line", "end_line", "severity", "category", "claim", "impact", "evidence_strength", "confidence", "evidence", "tools_consulted", "tests_consulted", "fixability", "status", "limitations", "provenance"],
  "properties": {
    "id": {"type": "string", "pattern": "^CA-[A-Z0-9][A-Z0-9._-]*$"},
    "file": {"type": "string", "minLength": 1},
    "start_line": {"type": "integer", "minimum": 1},
    "end_line": {"type": "integer", "minimum": 1},
    "severity": {"enum": ["info", "low", "medium", "high", "blocker"]},
    "category": {"type": "string", "minLength": 1},
    "claim": {"type": "string", "minLength": 1},
    "impact": {"type": "string", "minLength": 1},
    "evidence_strength": {"enum": ["none", "weak", "supported", "strong", "reproduced"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "evidence": {"type": "array", "items": {"type": "string"}},
    "tools_consulted": {"type": "array", "items": {"type": "string"}},
    "tests_consulted": {"type": "array", "items": {"type": "string"}},
    "fixability": {"enum": ["unknown", "not_fixable", "review_required", "suggested", "validated"]},
    "status": {"enum": ["detected", "review_only", "suggested", "validated", "rejected", "abstained"]},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "abstention_reason": {"type": "string"},
    "provenance": {"type": "object", "additionalProperties": true}
  },
  "allOf": [{"if": {"properties": {"status": {"const": "abstained"}}}, "then": {"required": ["abstention_reason"]}}, {"if": {"properties": {"end_line": {"type": "integer"}, "start_line": {"type": "integer"}}}, "then": {"$comment": "Callers must enforce end_line >= start_line."}}]
}
