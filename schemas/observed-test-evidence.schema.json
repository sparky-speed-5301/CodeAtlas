{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codeatlas.dev/schemas/observed-test-evidence.schema.json",
  "title": "ObservedTestEvidence",
  "description": "Bounded observed scope only. Runtime additionally enforces a 16000-byte JSON budget and a 4000-byte diagnostics budget.",
  "type": "object",
  "additionalProperties": false,
  "required": ["proposal_id", "sandbox_id", "runner", "language", "command", "targets", "status", "tests_passed", "tests_failed", "tests_skipped", "failed_test_names", "failure_summary", "duration_ms", "output_truncated", "redaction_audit", "network_policy_requested", "network_policy_enforced", "network_isolation_verified", "limitations"],
  "properties": {
    "proposal_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "sandbox_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "runner": {"enum": ["pytest", "unittest", "vitest", "jest"]},
    "language": {"enum": ["python", "typescript", "javascript"]},
    "command": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"type": "string", "maxLength": 512}},
    "targets": {"type": "array", "maxItems": 64, "items": {"type": "string", "maxLength": 512}},
    "status": {"enum": ["passed", "failed", "timed_out", "error"]},
    "tests_passed": {"type": "integer", "minimum": 0, "maximum": 1000000000},
    "tests_failed": {"type": "integer", "minimum": 0, "maximum": 1000000000},
    "tests_skipped": {"type": "integer", "minimum": 0, "maximum": 1000000000},
    "failed_test_names": {"type": "array", "maxItems": 10, "items": {"type": "string", "maxLength": 160}},
    "failure_summary": {"type": "string", "maxLength": 500},
    "stack_trace_summary": {"type": "string", "maxLength": 2000},
    "duration_ms": {"type": "number", "minimum": 0, "maximum": 31536000000},
    "output_truncated": {"type": "boolean"},
    "redaction_audit": {
      "type": "object",
      "required": ["safe"],
      "properties": {
        "safe": {"const": true},
        "raw_value_matches": {"type": "integer", "minimum": 0, "maximum": 1000000000},
        "redacted_items_count": {"type": "integer", "minimum": 0, "maximum": 1000000000},
        "rules_applied": {"type": "array", "maxItems": 20, "items": {"type": "string", "maxLength": 128}},
        "targets_audited": {"type": "array", "maxItems": 64, "items": {"type": "string", "maxLength": 128}}
      }
    },
    "network_policy_requested": {"type": "string", "maxLength": 64},
    "network_policy_enforced": {"type": "boolean"},
    "network_isolation_verified": {"type": "boolean"},
    "limitations": {
      "type": "array", "maxItems": 20, "items": {"type": "string", "maxLength": 512},
      "contains": {"const": "Observed test evidence covers only the executed scope and does not prove patch correctness or absence of other regressions."}
    },
    "full_suite": {"type": "boolean"},
    "observed_evidence_only": {"const": true}
  }
}
