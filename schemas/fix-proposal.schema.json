{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "codeatlas/fix-proposal.schema.json",
  "title": "CodeAtlas FixProposal",
  "description": "Typed, bounded, redacted fix proposal contract. Approval tokens are never returned; validation evidence is attached only after the explicit validate operation runs in an isolated worktree.",
  "type": "object",
  "required": [
    "proposal_id",
    "finding_id",
    "run_id",
    "repository",
    "base_commit",
    "head_commit",
    "target_files",
    "patch_text",
    "patch_hash",
    "diagnosis",
    "explanation",
    "expected_behavior_change",
    "assumptions",
    "risk_level",
    "confidence",
    "evidence_strength",
    "evidence_sources",
    "quality_decision",
    "policy_decision",
    "generation_status",
    "approval_required",
    "limitations",
    "created_at",
    "schema_version",
    "validation_operation",
    "validation_status",
    "validation_result",
    "review_packet",
    "human_approval_manifest",
    "validation_history"
  ],
  "additionalProperties": false,
  "properties": {
    "proposal_id": {
      "type": "string",
      "minLength": 0,
      "maxLength": 128,
      "description": "Existing PatchProposal ID; empty for non-draft lifecycle states."
    },
    "finding_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^CA-[A-Z0-9][A-Z0-9._-]*$"
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "description": "Service review run identifier this proposal is scoped to."
    },
    "repository": {
      "type": "string",
      "maxLength": 128,
      "description": "Repository identity only; never an absolute local path."
    },
    "base_commit": { "type": "string", "maxLength": 128 },
    "head_commit": { "type": "string", "maxLength": 128 },
    "target_files": {
      "type": "array",
      "maxItems": 1,
      "items": { "type": "string", "minLength": 1, "maxLength": 512 }
    },
    "patch_text": {
      "type": "string",
      "maxLength": 64000,
      "description": "Bounded unified diff of the draft proposal; redaction-audited."
    },
    "patch_hash": { "type": "string", "maxLength": 128 },
    "diagnosis": { "type": "string", "maxLength": 2000 },
    "explanation": { "type": "string", "maxLength": 2000 },
    "expected_behavior_change": { "type": "string", "maxLength": 2000 },
    "assumptions": {
      "type": "array",
      "maxItems": 10,
      "items": { "type": "string", "minLength": 1, "maxLength": 512 }
    },
    "risk_level": { "type": "string", "enum": ["low", "medium", "high"] },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "evidence_strength": {
      "type": "string",
      "enum": ["none", "weak", "supported", "strong"]
    },
    "evidence_sources": {
      "type": "array",
      "maxItems": 10,
      "items": { "type": "string", "minLength": 1, "maxLength": 512 }
    },
    "quality_decision": {
      "type": "string",
      "enum": [
        "report",
        "report_with_uncertainty",
        "review_only",
        "abstain",
        "suppress_low_evidence",
        "suppress_duplicate"
      ]
    },
    "policy_decision": {
      "type": "object",
      "maxProperties": 16,
      "additionalProperties": true
    },
    "generation_status": {
      "type": "string",
      "enum": [
        "not_eligible",
        "generating",
        "generation_failed",
        "rejected_by_policy",
        "draft_ready",
        "rejected",
        "regeneration_requested",
        "applied"
      ]
    },
    "approval_required": {
      "type": "boolean",
      "const": true,
      "description": "A fix proposal always requires human approval; the value can never be false."
    },
    "limitations": {
      "type": "array",
      "maxItems": 20,
      "items": { "type": "string", "minLength": 1, "maxLength": 512 }
    },
    "rejection_reason": {
      "type": ["string", "null"],
      "maxLength": 128,
      "description": "Stable machine-readable reason code for non-draft states."
    },
    "rejection_explanation": {
      "type": ["string", "null"],
      "maxLength": 512,
      "description": "Fixed, user-safe explanation; never raw provider or exception text."
    },
    "created_at": { "type": "string", "maxLength": 64 },
    "schema_version": { "type": "string", "const": "11C-D.1" },
    "validation_operation": { "type": "string", "const": "validate" },
    "validation_status": {
      "type": "string",
      "enum": [
        "not_requested",
        "approval_required",
        "approved_for_validation",
        "validating",
        "applied_in_isolated_worktree",
        "tests_running",
        "validated",
        "applied",
        "reverted",
        "validation_failed",
        "cleanup_failed"
      ]
    },
    "validation_result": { "type": ["object", "null"], "additionalProperties": true },
    "review_packet": { "type": ["object", "null"], "additionalProperties": true },
    "human_approval_manifest": { "type": ["object", "null"], "additionalProperties": true },
    "validation_history": {
      "type": "array",
      "maxItems": 16,
      "items": { "type": "string", "maxLength": 64 }
    }
  }
}
