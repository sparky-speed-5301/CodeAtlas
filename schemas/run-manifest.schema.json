{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codeatlas.dev/schemas/run-manifest.schema.json",
  "title": "CodeAtlas Run Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["run_id", "repository", "base_ref", "head_ref", "base_commit", "head_commit", "analyzed_files", "skipped_files", "unresolved_files", "detected_languages", "tools_run", "tests_run", "model", "model_version", "configuration", "duration_ms", "token_usage", "cost", "findings", "analyzers", "analyzer_failures", "errors"],
  "properties": {
    "run_id": {"type": "string", "minLength": 1},
    "repository": {"type": "string", "minLength": 1},
    "base_ref": {"type": "string", "minLength": 1},
    "head_ref": {"type": "string", "minLength": 1},
    "base_commit": {"type": ["string", "null"], "minLength": 1},
    "head_commit": {"type": ["string", "null"], "minLength": 1},
    "analyzed_files": {"type": "array", "items": {"type": "string"}},
    "skipped_files": {"type": "array", "items": {"type": "string"}},
    "unresolved_files": {"type": "array", "items": {"type": "string"}},
    "detected_languages": {"type": "array", "items": {"type": "string"}},
    "changes": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["path", "status"], "properties": {"path": {"type": "string"}, "old_path": {"type": ["string", "null"]}, "status": {"type": "string"}, "old_ranges": {"type": "array", "items": {"type": "object"}}, "new_ranges": {"type": "array", "items": {"type": "object"}}}}},
    "tools_run": {"type": "array", "items": {"type": "string"}},
    "tests_run": {"type": "array", "items": {"type": "string"}},
    "model": {"type": ["string", "null"]},
    "model_version": {"type": ["string", "null"]},
    "configuration": {"type": "object", "additionalProperties": true},
    "duration_ms": {"type": "number", "minimum": 0},
    "token_usage": {"type": "object", "additionalProperties": true},
    "cost": {"type": ["number", "null"], "minimum": 0},
    "findings": {"type": "array", "items": {"type": "object"}},
    "analyzers": {"type": "array", "items": {"type": "string"}},
    "analyzer_failures": {"type": "array", "items": {"type": "string"}},
    "errors": {"type": "array", "items": {"type": "string"}},
    "quality_version": {"type": "string"},
    "quality_summary": {"type": "object", "additionalProperties": true},
    "quality_limitations": {"type": "array", "items": {"type": "string"}},
    "quality_decisions": {"type": "array", "items": {"type": "string"}},
    "index_version": {"type": ["string", "null"]},
    "indexed_files": {"type": ["integer", "null"]},
    "indexed_symbols": {"type": ["integer", "null"]},
    "indexed_imports": {"type": ["integer", "null"]},
    "index_diagnostics": {"type": "array", "items": {"type": "object"}},
    "changed_symbols": {"type": "array", "items": {"type": "object"}},
    "context_candidates": {"type": "array", "items": {"type": "object"}},
    "index_duration_ms": {"type": ["number", "null"], "minimum": 0},
    "retrieval_duration_ms": {"type": ["number", "null"], "minimum": 0},
    "review_packet_id": {"type": ["string", "null"]},
    "packet_bytes": {"type": ["integer", "null"]},
    "packet_files": {"type": ["integer", "null"]},
    "packet_lines": {"type": ["integer", "null"]},
    "packet_truncated": {"type": ["boolean", "null"]},
    "packet_limitations": {"type": "array", "items": {"type": "string"}},
    "redaction_audit": {"type": ["object", "null"], "additionalProperties": true},
    "policy_decisions": {"type": "array", "items": {"type": "object"}},
    "provider_name": {"type": ["string", "null"]},
    "provider_version": {"type": ["string", "null"]},
    "provider_output_valid": {"type": ["boolean", "null"]},
    "provider_validation_errors": {"type": "array", "items": {"type": "string"}},
    "live_provider_enabled": {"type": ["boolean", "null"]},
    "model_name": {"type": ["string", "null"]},
    "provider_request_id": {"type": ["string", "null"]},
    "provider_latency_ms": {"type": ["number", "null"], "minimum": 0},
    "provider_retries": {"type": ["integer", "null"], "minimum": 0},
    "provider_usage": {"type": "object", "additionalProperties": true},
    "provider_cost": {"type": ["number", "null"], "minimum": 0},
    "provider_abstentions": {"type": "array", "items": {"type": "string"}},
    "provider_safety_events": {"type": "array", "items": {"type": "string"}},
    "merged_findings": {"type": "array", "items": {"type": "object"}},
    "patch_proposals": {"type": "array", "items": {"type": "object"}},
    "patch_validation": {"type": ["object", "null"], "additionalProperties": true},
    "patch_suggestions_received": {"type": ["integer", "null"], "minimum": 0},
    "patch_suggestions_accepted": {"type": ["integer", "null"], "minimum": 0},
    "patch_suggestions_rejected": {"type": ["integer", "null"], "minimum": 0},
    "patch_proposal_ids": {"type": "array", "items": {"type": "string"}},
    "patch_proposal_statuses": {"type": "array", "items": {"type": "string"}},
    "patch_rejection_reasons": {"type": "array", "items": {"type": "string"}},
    "patch_suggestion_redaction_audit": {"type": ["object", "null"], "additionalProperties": true},
    "patch_policy_decisions": {"type": "array", "items": {"type": "object"}},
    "automatic_application_attempted": {"type": ["boolean", "null"]},
    "automatic_application_blocked": {"type": ["boolean", "null"]},
    "approval_verified": {"type": ["boolean", "null"]},
    "approval_scope": {"type": ["string", "null"]},
    "approval_operation": {"type": ["string", "null"]},
    "proposal_id": {"type": ["string", "null"]},
    "patch_hash": {"type": ["string", "null"]},
    "test_evidence_attached": {"type": "boolean"},
    "test_evidence_summary": {"type": "string", "maxLength": 4000},
    "validation_limitations": {"type": "array", "items": {"type": "string"}},
    "isolated_validation_attempted": {"type": ["boolean", "null"]},
    "isolated_validation_status": {"type": ["string", "null"]},
    "sandbox_id": {"type": ["string", "null"]},
    "applies_cleanly": {"type": ["boolean", "null"]},
    "syntax_valid": {"type": ["boolean", "null"]},
    "tests_status": {"type": ["string", "null"]},
    "build_status": {"type": ["string", "null"]},
    "execution_allowed": {"type": ["boolean", "null"]},
    "resulting_diff_hash": {"type": ["string", "null"]},
    "cleanup_status": {"type": ["string", "null"]},
    "validation_warnings": {"type": "array", "items": {"type": "string"}},
    "test_plan": {"type": ["object", "null"], "additionalProperties": true},
    "test_runner": {"type": ["string", "null"]},
    "test_discovery_reason": {"type": ["string", "null"]},
    "test_exit_code": {"type": ["integer", "null"]},
    "test_duration_ms": {"type": ["number", "null"], "minimum": 0},
    "test_failures": {"type": "array", "items": {"type": "string"}},
    "test_timeout": {"type": ["number", "null"], "minimum": 0},
    "test_output_redaction_audit": {"type": ["object", "null"], "additionalProperties": true},
    "network_allowed": {"type": ["boolean", "null"]},
    "dependency_install_allowed": {"type": ["boolean", "null"]},
    "resource_limits": {"type": ["object", "null"], "additionalProperties": true},
    "test_execution_attempted": {"type": ["boolean", "null"]},
    "test_execution_blocked_reason": {"type": ["string", "null"]},
    "diagnostic_summary": {"type": ["string", "null"]},
    "failed_test_names": {"type": "array", "items": {"type": "string"}},
    "test_failure_count": {"type": ["integer", "null"], "minimum": 0},
    "test_pass_count": {"type": ["integer", "null"], "minimum": 0},
    "test_skip_count": {"type": ["integer", "null"], "minimum": 0},
    "test_output_truncated": {"type": ["boolean", "null"]},
    "network_policy_requested": {"type": ["string", "null"]},
    "network_policy_enforced": {"type": ["boolean", "null"]},
    "network_isolation_verified": {"type": ["boolean", "null"]},
    "diagnostic_limitations": {"type": "array", "items": {"type": "string"}},
    "full_suite_requested": {"type": ["boolean", "null"]},
    "full_suite_policy_opted_in": {"type": ["boolean", "null"]},
    "full_suite_status": {"type": ["string", "null"]},
    "full_suite_blocked_reason": {"type": ["string", "null"]},
    "full_suite_command": {"type": "array", "items": {"type": "string"}},
    "full_suite_result": {"type": ["object", "null"], "additionalProperties": true}
  },
  "allOf": [
    {
      "if": {"required": ["proposal_id"], "properties": {"proposal_id": {"type": "string"}}},
      "then": {
        "required": ["approval_scope", "proposal_id", "patch_hash", "base_commit", "sandbox_id", "approval_verified", "test_evidence_attached", "test_evidence_summary", "validation_limitations", "network_isolation_verified"],
        "properties": {"network_isolation_verified": {"type": "boolean"}, "approval_verified": {"type": "boolean"}}
      }
    },
    {
      "if": {"required": ["test_evidence_attached"], "properties": {"test_evidence_attached": {"const": true}}},
      "then": {
        "required": ["proposal_id", "sandbox_id", "approval_verified", "test_evidence_summary"],
        "properties": {
          "proposal_id": {"type": "string", "minLength": 1},
          "sandbox_id": {"type": "string", "minLength": 1},
          "approval_verified": {"const": true},
          "test_evidence_summary": {"type": "string", "minLength": 1}
        }
      }
    }
  ]
}
