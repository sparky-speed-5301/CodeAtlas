{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codeatlas.dev/schemas/repair-provider-config.schema.json",
  "title": "CodeAtlas Repair Provider Configuration (Phase 12A)",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "provider_name": {"enum": ["offline", "openai_compatible", "live"]},
    "model_name": {"type": "string", "minLength": 1, "maxLength": 128},
    "api_base_url": {"type": ["string", "null"]},
    "api_key_env_var": {"type": "string", "minLength": 1, "maxLength": 128},
    "mode": {"enum": ["offline", "online"]},
    "enabled": {"type": "boolean"},
    "timeout_seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 600},
    "max_response_bytes": {"type": "integer", "minimum": 1024, "maximum": 2000000},
    "max_repair_attempts": {"type": "integer", "minimum": 1, "maximum": 5},
    "max_retries": {"type": "integer", "minimum": 0, "maximum": 3},
    "token_budget": {"type": ["integer", "null"], "minimum": 1, "maximum": 2000000},
    "cost_token_budget": {"type": ["number", "null"], "exclusiveMinimum": 0, "maximum": 100000},
    "deterministic_fallback": {"type": "boolean"}
  }
}
